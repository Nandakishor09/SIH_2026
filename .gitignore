# ==============================================================================
# Legal Metrology Compliance Checker - .gitignore
# ==============================================================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# --- Testing, Coverage & Linters ---
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# --- Logs & Databases ---
*.log
logs/
*.sqlite3
*.db

# --- Temporary & Scratch Files ---
*.tmp
*.temp
temp/
tmp/
scratch/

# --- IDE & Editor Settings ---
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- Operating System Files ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory

# --- Frontend & Node (if applicable) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
